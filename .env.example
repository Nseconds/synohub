OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_THREAD=6
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=60m

# GEMINI CONFIG
GEMINI_API_KEY=
